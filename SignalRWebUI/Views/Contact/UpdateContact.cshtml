@model UpdateContactDto


@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">İletişim İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">İletişim Güncelleme Sayfası</div>
						</div>
						<input type="hidden" asp-for="ContactID" />
						<div class="card-body">
							<div class="form-group">
								<label for="location">Konumu Giriniz</label>
								<input type="text" class="form-control" id="location" asp-for="Location">
							</div>
							<div class="form-group">
								<label for="phonenumber">Telefon Numarası Giriniz</label>
								<input type="text" class="form-control" id="phonenumber" asp-for="PhoneNumber">
							</div>
							<div class="form-group">
								<label for="mail">Mail Adresi Giriniz</label>
								<input type="email" class="form-control" id="mail" asp-for="Mail">
							</div>
							<div class="form-group">
								<label for="footertitle">Alt Başlık Giriniz</label>
								<input type="text" class="form-control" id="footertitle" asp-for="FooterTitle">
							</div>
							<div class="form-group">
								<label for="opendays">Açık Günler Giriniz</label>
								<input type="text" class="form-control" id="opendays" asp-for="OpenDays">
							</div>
							<div class="form-group">
								<label for="opendaysdescription">Açık Günler Açıklaması Giriniz</label>
								<input type="text" class="form-control" id="opendaysdescription" asp-for="OpenDaysDescription">
							</div>
							<div class="form-group">
								<label for="openhour">Açık Saatleri Giriniz</label>
								<input type="text" class="form-control" id="openhour" asp-for="OpenHours">
							</div>
							<div class="form-group">
								<label for="description">Açıklama Giriniz</label>
								<textarea rows="5" class="form-control" asp-for="FooterDescription" id="description"></textarea>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">Hakkımızda Yazısını Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

