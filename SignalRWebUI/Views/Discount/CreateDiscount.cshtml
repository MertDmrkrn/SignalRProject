@model CreateDiscountDto

@{
    ViewData["Title"] = "CreateDiscount";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">İndirim İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni İndirimli İşlem Girişi</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="title">Ürün Adını Giriniz</label>
								<input type="text" class="form-control" id="title" asp-for="Title" placeholder="Ürün Adı">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="amount">Ürün İndirim Oranı Giriniz</label>
								<input type="text" class="form-control" id="amount" asp-for="Amount">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="imgurl">Ürün Görselini Giriniz</label>
								<input type="text" class="form-control" id="imgurl" asp-for="ImgUrl" placeholder="Ürün Görseli">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="description">Ürün Açıklamasını Giriniz</label>
								<input type="text" class="form-control" id="description" asp-for="Description" placeholder="Açıklama">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">İndirimli Ürünü Ekle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>


