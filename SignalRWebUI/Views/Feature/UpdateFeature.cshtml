@model UpdateFeatureDto


@{
    ViewData["Title"] = "UpdateFeature";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Öne Çıkan Alan İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Öne Çıkan Alan Girişi</div>
						</div>
						<input type="hidden" asp-for="FeatureID"/>
						<div class="card-body">
							<div class="form-group">
								<label for="title1">1.Başlığı Giriniz</label>
								<input type="text" class="form-control" id="title1" asp-for="Title1" placeholder="1.Başlık">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="title2">2.Başlığı Giriniz</label>
								<input type="text" class="form-control" id="title2" asp-for="Title2" placeholder="2.Başlık">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="title3">3.Başlığı Giriniz</label>
								<input type="text" class="form-control" id="title3" asp-for="Title3" placeholder="3.Başlık">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="description1">1.Açıklamayı Giriniz</label>
								<input type="text" class="form-control" id="description1" asp-for="Descripton1" placeholder="1.Açıklama">
							</div>
						</div><div class="card-body">
							<div class="form-group">
								<label for="description2">2.Açıklamayı Giriniz</label>
								<input type="text" class="form-control" id="description2" asp-for="Descripton2" placeholder="2.Açıklama">
							</div>
						</div><div class="card-body">
							<div class="form-group">
								<label for="description3">3.Açıklamayı Giriniz</label>
								<input type="text" class="form-control" id="description3" asp-for="Descripton3" placeholder="3.Açıklama">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">Öne Çıkan Alanı Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

