@model CreateMailDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Mail Sayfası</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Mail Gönderme Paneli</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="receivermail">Alıcı Mail Adresi</label>
								<input type="text" class="form-control" id="receivermail" asp-for="ReceiverMail" placeholder="Alıcı">
							</div>
							<div class="form-group">
								<label for="subject">Konu</label>
								<input type="text" class="form-control" id="subject" asp-for="Subject" placeholder="Konu">
							</div>
							<div class="form-group">
								<label for="body">Mesajınız</label>
								<textarea asp-for="Body" rows="5" id="body" class="form-control" placeholder="Mesajınız..."></textarea> 
							</div>
							<div class="card-action">
								<button class="btn btn-primary">Gönder</button>
							</div>
						</div>

					</div>
				</form>
			</div>
		</div>
	</div>
</div>

