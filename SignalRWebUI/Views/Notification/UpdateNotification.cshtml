@model UpdateNotificationDto


@{
    ViewData["Title"] = "CreateNotification";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Bildirim İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <input type="hidden" asp-for=NotificationID />
                        <div class="card-header">
                            <div class="card-title">Bildirim Güncelleme Girişi</div>
                        </div>

                        <div class="card-body">
                            <div class="form-group">
                                <label for="notificationtype">Bildirim Türünü Giriniz</label>
                                <input type="text" class="form-control" id="notificationtype" asp-for="Type" placeholder="Bildirim Türü">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="notificationicon">Bildirim İkonu Giriniz</label>
                                <input type="text" class="form-control" id="notificationicon" asp-for="Icon" placeholder="Bildirim İkonu">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="notificationdescription">Bildirim Açıklamasını Giriniz</label>
                                <input type="text" class="form-control" id="notificationdescription" asp-for="Description" placeholder="Bildirim Açıklaması">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-primary">Bildirimi Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

