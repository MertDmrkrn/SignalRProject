@model UserEditDto

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Profil Ayarları</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Şifre ve Bilgi Güncelleme Sayfası</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="categoryname">Adınız</label>
								<input type="text" class="form-control" id="name" asp-for="Name" placeholder="Adınız">
							</div>
							<div class="form-group">
								<label for="categoryname">Soyadınız</label>
								<input type="text" class="form-control" id="surname" asp-for="Surname" placeholder="Soyadınız">
							</div>
							<div class="form-group">
								<label for="categoryname">Mail Adresiniz</label>
								<input type="email" class="form-control" id="mail" asp-for="Mail" placeholder="Mail">
							</div>
							<div class="form-group">
								<label for="categoryname">Kullanıcı Adınız</label>
								<input type="text" class="form-control" id="username" asp-for="Username" placeholder="Kullanıcı Adınız">
							</div>
							<div class="form-group">
								<label for="categoryname">Şifreniz</label>
								<input type="password" class="form-control" id="password" asp-for="Password" placeholder="Şifreniz">
							</div>
							<div class="form-group">
								<label for="categoryname">Şifrenizi Onaylayın</label>
								<input type="password" class="form-control" id="confirmpassword" asp-for="ConfirmPassword" placeholder="Şifre Onayla">
							</div>
							<div class="card-action">
								<button class="btn btn-primary">Bilgileri Güncelle</button>
							</div>
						</div>

					</div>
				</form>
			</div>
		</div>
	</div>
</div>
