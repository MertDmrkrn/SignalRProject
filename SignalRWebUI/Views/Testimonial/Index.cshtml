@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count=0;
    var statusTrue="Görünür Durumda";
    var statusFalse = "Görünmez Durumda";
}
<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Referans Yorum İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Referans Yorum Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                          Müşterilerin yaptığı yorumlar ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz.
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Ad Soyad</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                    <th scope="col">Görünür Durum</th>
                                    <th scope="col">Görünmez Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Name</td>
                                        @if(item.Status==true)
                                        {
                                            <td>@statusTrue</td>
                                        }
                                        @if (item.Status == false)
                                        {
                                            <td>@statusFalse</td>
                                        }
                                        <td><a href="/Testimonial/DeleteTestimonial/@item.TestimonialID" class="btn btn-outline-danger">Sil</a></td>
                                        <td><a href="/Testimonial/UpdateTestimonial/@item.TestimonialID" class="btn btn-outline-success">Güncelle</a></td>
                                        <td><a href="/Testimonial/VisibleStatus/@item.TestimonialID" class="btn btn-outline-warning">Görünür</a></td>
                                        <td><a href="/Testimonial/InvisibleStatus/@item.TestimonialID" class="btn btn-outline-dark">Görünmez</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/Testimonial/CreateTestimonial/" class="btn btn-primary">Yeni Müşteri Yorumu Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
