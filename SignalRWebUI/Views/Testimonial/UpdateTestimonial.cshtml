@model UpdateTestimonialDto

@{
    ViewData["Title"] = "UpdateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Müşteri Yorum İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Müşteri Yorumu Güncelleme Sayfası</div>
						</div>
						<div class="card-body">
							<input type="hidden" asp-for="TestimonialID"/>
							<div class="form-group">
								<label for="name">Müşteri Adını Giriniz</label>
								<input type="text" class="form-control" id="name" asp-for="Name" placeholder="Müşteri Adı">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="title">Müşteri Ünvanını Giriniz</label>
								<input type="text" class="form-control" id="title" asp-for="Title" placeholder="Ünvan">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="imgurl">Müşteri Resim Dosya Yolunu Giriniz</label>
								<input type="text" class="form-control" id="imgurl" asp-for="ImgUrl" placeholder="Dosya Yolu">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="comment">Müşteri Yorumunu Giriniz</label>
								<input type="text" class="form-control" id="comment" asp-for="Comment" placeholder="Yorum">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-primary">Müşteri Yorumunu Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

